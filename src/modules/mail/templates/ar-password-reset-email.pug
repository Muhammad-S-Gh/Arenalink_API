doctype html
html(lang="ar" dir="rtl")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title إعادة تعيين كلمة المرور - Arenalink
    style.
      :root {
        --primary: #1a92e2;
        --primary-dark: #0052cc;
        --dark: #333333;
        --medium: #51545e;
        --light: #a8aaaf;
        --background: #f4f4f7;
        --white: #ffffff;
        --border-radius: 8px;
        --shadow: 0 4px 12px rgba(0, 0, 0, 0.1);
      }
      
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }
      
      body {
        background-color: var(--background);
        padding: 20px;
        color: var(--medium);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        line-height: 1.6;
      }
      
      .email-container {
        width: 100%;
        max-width: 600px;
        margin: 30px auto;
        background-color: var(--white);
        border-radius: var(--border-radius);
        overflow: hidden;
        box-shadow: var(--shadow);
      }
      
      .header {
        background-color: var(--primary);
        padding: 30px;
        text-align: center;
        color: var(--white);
      }
      
      .logo {
        width: 160px;
        margin-bottom: 20px;
      }
      
      h1, h2 {
        font-size: 28px;
        color: var(--white);
        margin-bottom: 10px;
        font-weight: 600;
      }
      
      .content {
        padding: 30px;
      }
      
      p {
        font-size: 16px;
        margin: 16px 0;
        color: var(--medium);
      }
      
      .button {
        display: inline-block;
        padding: 12px 30px;
        margin: 25px 0;
        background-color: var(--primary);
        color: var(--white) !important;
        text-decoration: none;
        border-radius: var(--border-radius);
        font-weight: bold;
        font-size: 16px;
        text-align: center;
      }
      
      .code-container {
        background-color: #f8f9fa;
        border-radius: var(--border-radius);
        padding: 20px;
        text-align: center;
        margin: 30px 0;
        border: 1px dashed #e0e0e0;
      }
      
      .code {
        font-size: 42px;
        letter-spacing: 6px;
        font-weight: bold;
        color: var(--primary);
        font-family: monospace;
        display: inline-block;
        padding: 10px 20px;
        background: white;
        border-radius: var(--border-radius);
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
        direction: ltr;
      }
      
      .note {
        background-color: #fff9e6;
        border-left: 4px solid #ffcc00;
        padding: 15px;
        border-radius: 4px;
        margin: 25px 0;
        font-size: 14px;
      }
      
      .footer {
        padding: 25px;
        text-align: center;
        font-size: 13px;
        color: var(--light);
        background-color: #f9f9f9;
        border-top: 1px solid #eeeeee;
      }
      
      .contact {
        margin-top: 20px;
        font-size: 15px;
      }
      
      .contact a {
        color: var(--primary);
        text-decoration: none;
        font-weight: 500;
      }
      
      .url {
        word-break: break-all;
        color: var(--primary);
        font-size: 14px;
        direction: ltr;
        text-align: left;
      }
      
      .divider {
        height: 1px;
        background: linear-gradient(to right, transparent, #e0e0e0, transparent);
        margin: 25px 0;
      }
      
      .footer-links a {
        color: var(--light);
        text-decoration: none;
        margin: 0 5px;
      }
      
      @media (max-width: 620px) {
        .email-container {
          margin: 10px;
        }
        
        .header {
          padding: 20px;
        }
        
        .content {
          padding: 20px;
        }
        
        h1, h2 {
          font-size: 24px;
        }
        
        .code {
          font-size: 32px;
          letter-spacing: 4px;
        }
        
        .button {
          display: block;
          width: 100%;
        }
      }

  body
block content
  - const title = 'إعادة تعيين كلمة المرور';
  - const lang = 'ar';
  - const direction = 'rtl';
  - const textAlign = 'right';
  - const noteBorderSide = 'right';
  - const dividerDirection = 'left';
  
  .email-container
    .header
      img.logo(src="https://cdn-icons-png.flaticon.com/128/8983/8983107.png" alt="Arenalink")
      h1 إعادة تعيين كلمة المرور
    
    .content
      p مرحباً،
      p لقد تلقينا طلباً لإعادة تعيين كلمة المرور لحسابك. يرجى استخدام رمز التحقق التالي:
      
      .code-container
        .code #{otp}
      
      p سيصبح هذا الرمز غير صالح خلال #[strong 15 دقيقة]. يرجى عدم مشاركة هذا الرمز مع أي شخص.
      
      .note
        p إذا لم تطلب إعادة تعيين كلمة المرور، يمكنك تجاهل هذه الرسالة بأمان. قد يكون شخص آخر قد أدخل بريدك الإلكتروني عن طريق الخطأ.
      
      .divider
      
      p.contact هل تحتاج إلى مساعدة؟ #[a(href="mailto:support@arenalink.com") اتصل بفريق الدعم]
    
    .footer
      p © #{new Date().getFullYear()} Arenalink. جميع الحقوق محفوظة.
      p هذه رسالة تلقائية - يرجى عدم الرد عليها
      p.footer-links
        a(href="https://arenalink.com/privacy") سياسة الخصوصية
        | | 
        a(href="https://arenalink.com/terms") الشروط والأحكام